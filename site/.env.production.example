# Copy to .env.production on the server and fill in real secrets.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Public site URL (no trailing slash). Used for canonical URLs, CORS, OpenGraph.
NEXT_PUBLIC_SERVER_URL=https://sarapis.org

# REQUIRED — keep this stable; changing it invalidates all admin sessions.
PAYLOAD_SECRET=__CHANGE_ME__

# Used to validate draft-preview links.
PREVIEW_SECRET=__CHANGE_ME__

# Authorizes scheduled jobs (not heavily used; set to a random value).
CRON_SECRET=__CHANGE_ME__

# DB + media paths are set in the image (DATABASE_URI=/app/data, MEDIA_DIR=/app/media)
# and mapped to Docker volumes — no need to set them here.
