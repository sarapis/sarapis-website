# Copy to .env for local development.

# SQLite database file. This is also the default when unset; in development
# Payload creates the schema on first run.
DATABASE_URI=file:./sarapis.db

# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash. Match the
# port you run the dev server on (the README uses 3009).
NEXT_PUBLIC_SERVER_URL=http://localhost:3009

# Authorizes the GitHub activity sync (GET /next/github-sync with
# "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate draft-preview requests.
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Optional ─────────────────────────────────────────────────────────────────
# GitHub activity sync. SYNC_OWNERS replaces the default owner list; a private
# repo in another org needs its own GITHUB_TOKEN_<OWNER uppercased>.
# GITHUB_TOKEN=
# SYNC_OWNERS=
# PUBLISH_ACTORS=
# AI summaries of activity (Gemini).
# GEMINI_API_KEY=
# Donations (Stripe embedded checkout).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
