# Copy to .env for local development.

# SQLite database file. This is also the default when unset; in development
# Payload creates the schema on first run.
DATABASE_URI=file:./sarapis.db

# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash. Match the
# port you run the dev server on (the README uses 3009).
NEXT_PUBLIC_SERVER_URL=http://localhost:3009

# Authorizes the GitHub activity sync (GET /next/github-sync with
# "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate draft-preview requests.
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Optional ─────────────────────────────────────────────────────────────────
# GitHub activity sync. SYNC_OWNERS replaces the default owner list; a private
# repo in another org needs its own GITHUB_TOKEN_<OWNER uppercased>.
# GITHUB_TOKEN=
# SYNC_OWNERS=
# PUBLISH_ACTORS=
# AI summaries of activity (Gemini).
# GEMINI_API_KEY=
# Donations (Stripe embedded checkout).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# "Sign in with the CMS" for collab-template sites (src/endpoints/collab-pass.ts).
# Unset = /api/collab-pass/start answers 503. The collab Worker holds the same
# secret as CMS_PASS_SECRET. Generate with: openssl rand -base64 48
# COLLAB_PASS_SECRET=
# COLLAB_PASS_HOSTS=comms-strat.sarapis.org

# Optional: email a note for each new campaign endorsement (hooks/notifyNewEndorsement.ts).
# All three, or it only logs. FROM must be on a domain verified in Resend.
# RESEND_API_KEY=
# No quotes around values: `docker run --env-file` keeps them, and Resend then
# rejects the sender (422 "Invalid `from` field"). Found 2026-11-24.
# ENDORSEMENT_NOTIFY_FROM=Sarapis CMS <cms@example.org>
# ENDORSEMENT_NOTIFY_TO=approver@example.org
# Campaign mailing list and automatic emails (src/lib/campaignEmail.ts), per
# campaign key upper-cased (nyc-ospo -> NYC_OSPO). Off until _FROM is set.
# CAMPAIGN_EMAIL_NYC_OSPO_FROM=NYC OSPO campaign <ospo@updates.example.org>
# CAMPAIGN_EMAIL_NYC_OSPO_REPLY_TO=team@example.org
# CAMPAIGN_EMAIL_NYC_OSPO_SEGMENT_ID=
# CAMPAIGN_EMAIL_NYC_OSPO_TOPIC_ID=
# 1: send with the Resend templates (nyc-ospo-welcome, nyc-ospo-endorsement-thanks,
# nyc-ospo-endorsement-live), edited in Resend; built-in words are the fallback.
# CAMPAIGN_EMAIL_NYC_OSPO_USE_TEMPLATES=1
